# ─────────────────────────────────────────────
# Instagram Agent — Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# Instagram Graph API
# Requires a Business or Creator account linked to a Facebook Page
# Permission needed: instagram_content_publish
INSTAGRAM_ACCESS_TOKEN=your_long_lived_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_business_account_id_here

# AI Provider — Google Gemini (primary)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Provider — OpenAI (optional fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Media generation provider: "gemini" or "openai"
MEDIA_PROVIDER=gemini

# Image hosting (required to publish images to Instagram)
# Instagram Graph API requires a public image URL — imgbb is used for this
# Free key at: https://imgbb.com/signup → Settings → API
IMGBB_API_KEY=your_imgbb_api_key_here

# Post language and default tone
POST_LANGUAGE=pt-BR
POST_TONE=engaging

# Optional markdown file with additional caption instructions
CAPTION_PROMPT_FILE=directives/caption_additional_prompt.md
