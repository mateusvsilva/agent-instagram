# Provedor de imagem: "gemini" (Google) ou "openai" (DALL-E)
IMAGE_PROVIDER=gemini

# Gemini — gere a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-image
GEMINI_ASPECT_RATIO=4:5
GEMINI_COST_PER_IMAGE=0.039

# OpenAI (DALL-E) — usado so se IMAGE_PROVIDER=openai
OPENAI_API_KEY=sk-...
DALLE_MODEL=dall-e-3
DALLE_DEFAULT_SIZE=1024x1792
DALLE_DEFAULT_QUALITY=hd
DALLE_DEFAULT_STYLE=vivid

# Cérebro de texto: "openai" (reusa OPENAI_API_KEY) ou "anthropic"
BRAIN_PROVIDER=openai
OPENAI_BRAIN_MODEL=gpt-4o-mini

# Budget control
DAILY_BUDGET_USD=2.00
MONTHLY_BUDGET_USD=50.00
BUDGET_ALERT_THRESHOLD=0.8

# Buffer (https://developers.buffer.com) — gere a chave nas configuracoes da conta
BUFFER_API_KEY=
BUFFER_CHANNEL_ID=
BUFFER_API_URL=https://api.buffer.com
# addToQueue = usa os horarios da sua fila no Buffer; customScheduled = agenda imediato
BUFFER_SCHEDULING_MODE=addToQueue

# Hospedagem de imagens (Buffer exige URL publica). cloudinary | none
IMAGE_HOST_BACKEND=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here
TELEGRAM_APPROVAL_TIMEOUT=7200

# Scheduler
SCHEDULER_TIMEZONE=America/Sao_Paulo
SCHEDULER_ENABLED=true

# Storage
DB_PATH=./data/db/agent.db

# General
LOG_LEVEL=INFO
MAX_IMAGES_PER_CAROUSEL=4
POST_COOLDOWN_MINUTES=30
MAX_REDO_ATTEMPTS=3
TEMPLATES_DIR=./data/templates
IMAGES_DIR=./data/images

# Criação conversacional (/criar)
CREATION_SESSION_TIMEOUT=1800
CREATION_MAX_ROUNDS=12
